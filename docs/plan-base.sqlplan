<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4305.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="EXEC dbo.usp_GetPerformance @PortfolioId = 7, @Year = 2023" StatementId="1" StatementCompId="1" StatementType="EXECUTE PROC" RetrievedFromCache="false"><StoredProc ProcName="dbo.usp_GetPerformance"><Statements><StmtSimple StatementText="&#xa;CREATE   PROCEDURE dbo.usp_GetPerformance&#xa;    @PortfolioId INT,&#xa;    @Year        INT&#xa;AS&#xa;BEGIN&#xa;    -- Retorno y P&amp;L por mes&#xa;    SELECT d.Mes,&#xa;           SUM(dbo.fn_PortfolioDailyReturn(@PortfolioId, d.Dia)) AS RetornoMes,&#xa;           (SELECT SUM(p.PnL)&#xa;            FROM dbo.PositionDaily p&#xa;            WHERE p.PortfolioId = @PortfolioId&#xa;              AND YEAR(p.AsOfDate) = @Year&#xa;              AND MONTH(p.AsOfDate) = d.Mes)                      AS PnLMes&#xa;    FROM (SELECT DISTINCT CONVERT(DATE, AsOfDate) AS Dia,&#xa;                          MONTH(AsOfDate)         AS Mes&#xa;          FROM dbo.PositionDaily&#xa;          WHERE PortfolioId = @PortfolioId&#xa;            AND YEAR(AsOfDate) = @Year) d&#xa;    GROUP BY d.Mes&#xa;    ORDER BY d.Mes" StatementId="2" StatementCompId="4" StatementType="SELECT" RetrievedFromCache="false" StatementSubTreeCost="133.135" StatementEstRows="12" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xCEE1FA8AF219367B" QueryPlanHash="0xB1B0018ED092CCB3" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan CachedPlanSize="128" CompileTime="12" CompileCPU="12" CompileMemory="1512" ContainsInlineScalarTsqlUdfs="1"><ThreadStat Branches="2"></ThreadStat><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(varchar(10),[FinPerf].[dbo].[PositionDaily].[AsOfDate],120)"></PlanAffectingConvert><PlanAffectingConvert ConvertIssue="Seek Plan" Expression="CONVERT(varchar(10),[FinPerf].[dbo].[PositionDaily].[AsOfDate],120)=CONVERT(varchar(10),[Expr1004],120)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="3072" SerialDesiredMemory="3952" GrantedMemory="0" MaxUsedMemory="0"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="54169" EstimatedPagesCached="40627" EstimatedAvailableDegreeOfParallelism="6" MaxCompileMemory="1942136"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-21T14:35:25.81" ModificationCount="0" SamplingPercent="3.47215" Statistics="[_WA_Sys_00000004_398D8EEE]" Table="[PositionDaily]" Schema="[dbo]" Database="[FinPerf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-21T14:37:02.77" ModificationCount="0" SamplingPercent="100" Statistics="[IX_PositionDaily_Portfolio_AsOfDate]" Table="[PositionDaily]" Schema="[dbo]" Database="[FinPerf]"></StatisticsInfo></OptimizerStatsUsage><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="12" EstimateIO="0" EstimateCPU="1.2e-06" AvgRowSize="36" EstimatedTotalSubtreeCost="133.135" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Expr1003"></ColumnReference><ColumnReference Column="Expr1016"></ColumnReference><ColumnReference Column="Expr1020"></ColumnReference></OutputList><ComputeScalar><DefinedValues><DefinedValue><ColumnReference Column="Expr1020"></ColumnReference><ScalarOperator ScalarString="[Expr1018]"><Identifier><ColumnReference Column="Expr1018"></ColumnReference></Identifier></ScalarOperator></DefinedValue></DefinedValues><RelOp NodeId="1" PhysicalOp="Parallelism" LogicalOp="Gather Streams" EstimateRows="12" EstimateIO="0" EstimateCPU="0.0285608" AvgRowSize="36" EstimatedTotalSubtreeCost="133.135" Parallel="1" EstimateRebinds="0